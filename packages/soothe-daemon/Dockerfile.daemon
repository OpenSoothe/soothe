# Soothe daemon — builds from pre-built base image (fast, ~30s).
# Build context must be the monorepo root (parent of `packages/`).
#
# Build using base image:
#   docker build -f packages/soothe-daemon/Dockerfile.daemon \
#     --build-arg BASE_IMAGE=registry.cn-hangzhou.aliyuncs.com/lacogito/soothed-base:latest \
#     -t soothed:latest .
#
# Run (publish unified listener on 8765: WebSocket + REST):
#   docker run --rm -p 8765:8765 \
#     -e OPENAI_API_KEY=... \
#     -v soothe-data:/var/lib/soothe \
#     soothed:latest

ARG BASE_IMAGE=registry.cn-hangzhou.aliyuncs.com/lacogito/soothed-base:latest
ARG PYTHON_BASE=registry.cn-hangzhou.aliyuncs.com/lacogito/python:3.12-bookworm

# ========================================
# Stage 1: Use pre-built base
# ========================================
FROM ${BASE_IMAGE} AS builder

WORKDIR /app

# Layer ordering for caching:
# 1. Copy pyproject only → cached if deps unchanged
# 2. uv pip install → cached if pyproject unchanged (uv checks metadata)
# 3. Copy source → rebuilds on source change, but skips install layer

# Copy VERSION file for hatch version detection (packages/soothe/pyproject.toml uses ../../VERSION)
COPY VERSION /app/VERSION

COPY packages/soothe/pyproject.toml packages/soothe/
COPY packages/soothe-sdk/pyproject.toml packages/soothe-sdk/
COPY packages/soothe-cli/pyproject.toml packages/soothe-cli/
COPY packages/soothe-daemon/pyproject.toml packages/soothe-daemon/

# Reinstall workspace packages if pyproject changed (uv skips if unchanged)
# Base image has editable installs pointing to /app/packages/*/src/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --no-deps \
        ./packages/soothe-sdk \
        ./packages/soothe-cli \
        './packages/soothe[all]' \
        ./packages/soothe-daemon

# Copy source code (replaces base stubs; editable installs pick up real code)
COPY packages ./packages

# ========================================
# Stage 2: Runtime
# ========================================
FROM ${PYTHON_BASE} AS runtime

LABEL org.opencontainers.image.title="Soothe Daemon" \
    org.opencontainers.image.description="Soothe agent orchestration daemon - built from base image" \
    org.opencontainers.image.source="https://github.com/OpenSoothe/soothe"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    SOOTHE_HOME=/var/lib/soothe \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    SOOTHE_DAEMON__TRANSPORTS__WEBSOCKET__HOST=0.0.0.0 \
    SOOTHE_DAEMON__TRANSPORTS__HTTP_REST__ENABLED=true \
    SOOTHE_DAEMON__TRANSPORTS__HTTP_REST__HOST=0.0.0.0

RUN echo "deb http://mirrors.aliyun.com/debian/ bookworm main contrib non-free" > /etc/apt/sources.list \
    && echo "deb http://mirrors.aliyun.com/debian/ bookworm-updates main contrib non-free" >> /etc/apt/sources.list \
    && echo "deb http://mirrors.aliyun.com/debian-security/ bookworm-security main contrib non-free" >> /etc/apt/sources.list

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /opt/ms-playwright /opt/ms-playwright

ENV PATH="/app/.venv/bin:${PATH}"

# Install runtime system deps (playwright browser libs + ffmpeg for media)
RUN apt-get update \
    && /app/.venv/bin/python -m playwright install-deps \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Create soothe user and directories
RUN useradd --create-home --system soothe \
    && mkdir -p /var/lib/soothe \
    && mkdir -p /home/soothe/.cache/soothe/models \
    && chown -R soothe:soothe /var/lib/soothe /opt/ms-playwright /home/soothe/.cache

# Copy embedding model cache from builder to soothe user's home (default cache path)
COPY --from=builder --chown=soothe:soothe /root/.cache/soothe/models/huggingface /home/soothe/.cache/soothe/models/huggingface

USER soothe
WORKDIR /var/lib/soothe

EXPOSE 8765/tcp

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import socket; s=socket.socket(); s.settimeout(3); s.connect(('localhost',8765)); s.close()" || exit 1

CMD ["python", "-m", "soothe_daemon"]