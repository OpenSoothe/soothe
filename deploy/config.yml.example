# Soothe Production Configuration
# PostgreSQL persistence + pgvector + DashScope/Coding-Plan providers.
#
# This config uses environment variable substitution (${ENV_VAR}).
# Copy this file to config.yml - no edits needed if .env is configured.
#
# Required env vars (set in .env):
#   DASHSCOPE_API_KEY        - DashScope provider credential
#   DASHSCOPE_CP_API_KEY     - Coding-Plan provider credential
#   DASHSCOPE_BASE_URL       - DashScope API base URL
#   DASHSCOPE_CP_BASE_URL    - Coding-Plan API base URL
#   POSTGRES_USER            - PostgreSQL username
#   POSTGRES_PASSWORD        - PostgreSQL password

# =============================================================================
# LLM Providers
# =============================================================================
providers:
  # DashScope - Alibaba's LLM platform (OpenAI-compatible)
  # Models: Qwen, MiniMax, Kimi, multimodal embedding
  - name: dashscope
    provider_type: openai
    api_base_url: "${DASHSCOPE_BASE_URL}"
    api_key: "${DASHSCOPE_API_KEY}"
    models:
      - qwen-max              # Premium reasoning model
      - multimodal-embedding-v1  # Embedding model

  # Coding-Plan - Alibaba's coding-focused endpoint
  # Models: GLM, DeepSeek, Qwen coding variants
  - name: coding-plan
    provider_type: openai
    api_base_url: "${DASHSCOPE_CP_BASE_URL}"
    api_key: "${DASHSCOPE_CP_API_KEY}"
    models:
      - glm-5                 # Zhipu AI GLM model
      - qwen3.6-plus          # Coding-optimized Qwen
      - kimi-k2.5             # Moonshot AI model
      - MiniMax-M2.5          # Alternative reasoning
      - deepseek-v3.2         # DeepSeek reasoning model

# =============================================================================
# Model Router
# =============================================================================
router:
  # Default model for general queries
  default: "coding-plan:glm-5"

  # Fast model for quick responses (lower cost)
  fast: "coding-plan:kimi-k2.5"

  # Thinking model for complex reasoning tasks
  think: "coding-plan:glm-5"

  # Vision model for image understanding
  image: "coding-plan:qwen3.6-plus"

  # Embedding model for vector search
  embedding: "dashscope:multimodal-embedding-v1"

# =============================================================================
# Persistence Backend
# =============================================================================
persistence:
  default_backend: postgresql
  # Base DSN for PostgreSQL - creates connections to multiple databases
  postgres_base_dsn: "postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@soothe-pgvector:5432"

# =============================================================================
# Vector Stores
# =============================================================================
vector_stores:
  - name: pgvector
    provider_type: pgvector
    # Dedicated vectors database (RFC-612 multi-database architecture)
    dsn: "postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@soothe-pgvector:5432/soothe_vectors"
    pool_size: 4
    # Optional: HNSW index configuration for better search performance
    index_config:
      index_type: hnsw
      m: 16
      ef_construction: 64

vector_store_router:
  default: "pgvector:soothe_default"

# =============================================================================
# Workspace Configuration
# =============================================================================
# Maps host paths to container paths so daemon can access client workspaces.
# Set SOOTHE_WORKSPACE_HOST_ROOT in .env to match your host directory.
workspace_mount:
  host_root: "${SOOTHE_WORKSPACE_HOST_ROOT:-/workspace}"
  container_root: /var/lib/soothe/workspaces
