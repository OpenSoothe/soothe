# Soothe Production Environment Variables
# Copy this file to .env and configure before deployment.

# =============================================================================
# PostgreSQL Configuration
# =============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# =============================================================================
# DashScope Provider (Qwen, MiniMax, Kimi, Embedding)
# =============================================================================

DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# =============================================================================
# Coding-Plan Provider (GLM, DeepSeek)
# =============================================================================

DASHSCOPE_CP_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
DASHSCOPE_CP_API_KEY=your_coding_plan_api_key_here